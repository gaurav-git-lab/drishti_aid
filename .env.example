# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE EARTH ENGINE (GEE) API CONFIGURATION:
# 1. Register for Google Earth Engine at https://earthengine.google.com
# 2. In Google Cloud Console (https://console.cloud.google.com), enable Earth Engine API for your project.
# 3. Under IAM & Admin > Service Accounts, create a Service Account with "Earth Engine Resource Viewer / User" role.
# 4. Generate and download a JSON Key, and configure the project ID and credentials below:
EARTH_ENGINE_PROJECT_ID="your-gcp-project-id"
EARTH_ENGINE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
EARTH_ENGINE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
EARTH_ENGINE_API_KEY=""

# NASA EARTHDATA (URS) LOGIN CONFIGURATION:
# Register at https://urs.earthdata.nasa.gov
# Generate Bearer Token under Applications > Generate Token for NASA GPM IMERG Precipitation,
# MODIS/VIIRS NRT surface flood water, and NASA SRTM DEM:
NASA_EARTHDATA_TOKEN="eyJ0eXAi..."

# OPENWEATHERMAP API KEY
# Register at https://openweathermap.org/api
# Used for live meteorological map overlays (precipitation & wind)
VITE_OPENWEATHER_API_KEY=""

# COPERNICUS DATA SPACE ECOSYSTEM
# Register at https://dataspace.copernicus.eu/
# Option A (Recommended): Create an OAuth Client in the Sentinel Hub Dashboard
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# Option B: Use your raw username/password (Direct Grant)
COPERNICUS_USERNAME=""
COPERNICUS_PASSWORD=""

# Option C: Pass a raw token
COPERNICUS_MANUAL_TOKEN=""

# GOOGLE MAPS PLATFORM API KEY:
# 1. Open Google Cloud Console: https://console.cloud.google.com/google/maps-apis/credentials
# 2. Click "Create Credentials" > "API Key"
# 3. Enable "Maps JavaScript API" under APIs & Services > Library
# 4. (Optional) Restrict key to HTTP referrers and Maps JavaScript API for production security
VITE_GOOGLE_MAPS_API_KEY=""


